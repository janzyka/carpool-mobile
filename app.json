{
  "expo": {
    "name": "Jedu",
    "slug": "carpool-mobile",
    "version": "1.0.0",
    "scheme": "carpool",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.zykyc.carpool",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSLocationWhenInUseUsageDescription": "Your location is used to centre the map when selecting a pickup or drop-off point.",
        "CFBundleURLTypes": [
          {
            "CFBundleURLSchemes": [
              "com.googleusercontent.apps.971278551355-62t0ol7n67ol3048iu2j5t7cjo2rict9"
            ]
          }
        ]
      }
    },
    "android": {
      "package": "com.zykyc.carpool",
      "googleServicesFile": "./google-services.json",
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyBl_wV3EsMmujU-jpuvWW_q5lN9FfisVWs"
        }
      },
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "@react-native-community/datetimepicker",
      "./plugins/withAdiRegistration",
      "@react-native-google-signin/google-signin",
      "expo-apple-authentication"
    ],
    "extra": {
      "apiUrl": "https://5pqwkyomu6.execute-api.eu-central-1.amazonaws.com/dev",
      "googleIosClientId": "971278551355-62t0ol7n67ol3048iu2j5t7cjo2rict9.apps.googleusercontent.com",
      "googleWebClientId": "971278551355-hpe1qvo5c2g4bt2rv3sp4cv96pbpjj41.apps.googleusercontent.com",
      "router": {},
      "eas": {
        "projectId": "ace7f8d3-7406-4001-b0b6-4afbfd53ba26"
      }
    },
    "locales": {
      "en": "./locales/en.json",
      "cs": "./locales/cs.json"
    },
    "privacyPolicyUrl": "https://janzyka.github.io/carpool-mobile/privacy-policy",
    "owner": "zykyc"
  }
}
